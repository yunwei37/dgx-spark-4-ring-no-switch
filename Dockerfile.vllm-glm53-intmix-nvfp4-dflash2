ARG DFLASH2_SOURCE_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6
ARG RUNTIME_IMAGE=ghcr.io/yunwei37/dgx-spark-4-ring-no-switch@sha256:52b289baf653bcb550194822f1c1381275601731d4882fefe7c0413513a99cae
ARG BUILD_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

FROM ${BUILD_IMAGE} AS mesh-builder

ARG NCCL_COMMIT=b91894bd5b190c874d98a017f93f5daa515b65d0
ARG MESH_COMMIT=19924dcc7c571d6e260953724d394ae50bad82cf

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates git libibverbs-dev pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/NVIDIA/nccl.git /src/nccl \
    && git -C /src/nccl checkout "${NCCL_COMMIT}" \
    && make -C /src/nccl -j"$(nproc)" src.build CUDA_HOME=/usr/local/cuda \
    && git clone https://github.com/autoscriptlabs/nccl-mesh-plugin.git /src/mesh \
    && git -C /src/mesh checkout "${MESH_COMMIT}" \
    && make -C /src/mesh -j"$(nproc)" \
    && mkdir -p /opt/nccl-mesh/lib \
    && install -m 0755 /src/nccl/build/lib/libnccl.so.2.29.7 /opt/nccl-mesh/lib/ \
    && install -m 0755 /src/mesh/libnccl-net.so /opt/nccl-mesh/lib/ \
    && ln -s libnccl.so.2.29.7 /opt/nccl-mesh/lib/libnccl.so.2 \
    && ln -s libnccl.so.2 /opt/nccl-mesh/lib/libnccl.so \
    && ln -s libnccl-net.so /opt/nccl-mesh/lib/libnccl-net-mesh.so \
    && rm -rf /src/nccl /src/mesh

FROM ${DFLASH2_SOURCE_IMAGE} AS dflash2-source

FROM ${RUNTIME_IMAGE}

ARG VCS_REF=unknown
ARG COMMUNITY_PORT_COMMIT=a1806cb82493aa6f28709f77acf59c1937bdf756
ARG DFLASH2_SOURCE_DIGEST=sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6
LABEL org.opencontainers.image.title="DGX Spark GLM-5.3 Int4/Int8Mix NVFP4-KV DFlash2 runtime" \
      org.opencontainers.image.description="Pinned NVFP4-KV runtime with the community DFlash2 port and FP32 router correction" \
      org.opencontainers.image.source="https://github.com/yunwei37/dgx-spark-4-ring-no-switch" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="NOASSERTION" \
      io.yunwei37.dflash2-community-revision="${COMMUNITY_PORT_COMMIT}" \
      io.yunwei37.dflash2-source-digest="${DFLASH2_SOURCE_DIGEST}"

COPY --from=mesh-builder /opt/nccl-mesh /opt/nccl-mesh

ADD --checksum=sha256:c2fd1bc93957c8a534b03cc83d9d6c28cf7238a9a8ab7113b919f7e013e37c42 \
    https://github.com/tonyd2wild/GLM-5.3-Int4-Int8Mix-TP4-4x-DGX-Spark/archive/a1806cb82493aa6f28709f77acf59c1937bdf756.tar.gz \
    /tmp/community-port.tar.gz
COPY --from=dflash2-source \
    /usr/local/lib/python3.12/dist-packages/vllm/model_executor/models/qwen3_dflash2.py \
    /tmp/dflash2-source/qwen3_dflash2.py
COPY --from=dflash2-source \
    /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dflash2/__init__.py \
    /tmp/dflash2-source/__init__.py
COPY --from=dflash2-source \
    /usr/local/lib/python3.12/dist-packages/vllm/v1/worker/gpu/spec_decode/dflash2/speculator.py \
    /tmp/dflash2-source/speculator.py
COPY images/runtime/dsa_block.py /tmp/dsa_block.py
COPY images/runtime/apply_dflash2_swa_under_mla.py /tmp/apply_dflash2_swa_under_mla.py

RUN set -eux; \
    mkdir -p /tmp/community-port; \
    tar -xzf /tmp/community-port.tar.gz -C /tmp/community-port --strip-components=1; \
    test "$(python3 -c 'import vllm; print(vllm.__version__)')" = \
      "0.23.1rc1.dev190+gab6660699.d20260705"; \
    sp=/usr/local/lib/python3.12/dist-packages; \
    vr=${sp}/vllm; \
    install -m 0644 /tmp/dflash2-source/qwen3_dflash2.py \
      ${vr}/model_executor/models/qwen3_dflash2.py; \
    mkdir -p ${vr}/v1/worker/gpu/spec_decode/dflash2; \
    install -m 0644 /tmp/dflash2-source/__init__.py \
      ${vr}/v1/worker/gpu/spec_decode/dflash2/__init__.py; \
    install -m 0644 /tmp/dflash2-source/speculator.py \
      ${vr}/v1/worker/gpu/spec_decode/dflash2/speculator.py; \
    install -m 0644 /tmp/dsa_block.py /tmp/community-port/dflash2-port/dsa_block.py; \
    python3 /tmp/community-port/dflash2-port/patch_base_dflash2.py ${vr}; \
    python3 /tmp/community-port/dflash2-port/patch_base_kv_dsa.py ${vr}; \
    python3 /tmp/apply_dflash2_swa_under_mla.py ${vr}; \
    python3 /tmp/community-port/dflash2-port/verify_dflash2.py; \
    test "$(sha256sum ${vr}/model_executor/models/deepseek_v2.py | cut -d' ' -f1)" = \
      "d6cf87377e530c878b7f4a12b1517c08ba4213f320caa337b5e9c1462db4e24e"; \
    find ${vr} -type d -name __pycache__ -prune -exec rm -rf {} +; \
    rm -rf /tmp/community-port /tmp/dflash2-source \
      /tmp/community-port.tar.gz \
      /tmp/dsa_block.py /tmp/apply_dflash2_swa_under_mla.py

ENV LD_LIBRARY_PATH=/opt/nccl-mesh/lib:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64
