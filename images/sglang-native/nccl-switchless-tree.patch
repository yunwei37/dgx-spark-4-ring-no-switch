   const int nChannels = comm->nChannels, nNodes = comm->nNodes, node = comm->node;
+  if (ncclParamSwitchlessRingOnly() && comm->nRanks == 4 && nNodes == 4)
+    return connectSwitchlessTrees(comm, ringNext);
 
