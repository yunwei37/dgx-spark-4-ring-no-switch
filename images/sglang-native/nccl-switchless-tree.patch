+// Four one-GPU nodes: complementary spanning paths use only physical-ring
+// neighbours. Build before devCommSetup, including NCCL_RUNTIME_CONNECT=1.
+extern int64_t ncclParamSwitchlessRingOnly();
+static ncclResult_t connectSwitchlessTrees(struct ncclComm* comm, int* ringNext) {
+  static const int parent[2][4] = {{-1, 0, 1, 0}, {3, 2, -1, 2}};
+  static const int child0[2][4] = {{1, 2, -1, -1}, {-1, -1, 3, 0}};
+  static const int child1[2][4] = {{3, -1, -1, -1}, {-1, -1, 1, -1}};
+  for (int c = 0; c < comm->nChannels; c++) {
+    const int* next = ringNext + c * comm->nRanks;
+    int order[4] = {0, -1, -1, -1}, seen = 1;
+    for (int i = 1; i < 4; i++) {
+      int r = next[order[i - 1]];
+      if (r < 0 || r >= 4 || (seen & (1 << r))) return ncclInternalError;
+      order[i] = r;
+      seen |= 1 << r;
+    }
+    if (next[order[3]] != 0) return ncclInternalError;
+    // Canonicalize direction, so adjacent channels keep complementary trees
+    // even if NCCL truncates the duplicated channel array.
+    if (order[1] > order[3]) std::swap(order[1], order[3]);
+    int position = 0;
+    while (order[position] != comm->rank) position++;
+    for (int t = 0; t < 2; t++) {
+      const int type = (c + t * comm->nChannels) % 2;
+      struct ncclTree* tree = &comm->channels[c + t * comm->nChannels].tree;
+      tree->up = parent[type][position] < 0 ? -1 : order[parent[type][position]];
+      tree->down[0] = child0[type][position] < 0 ? -1 : order[child0[type][position]];
+      tree->down[1] = child1[type][position] < 0 ? -1 : order[child1[type][position]];
+      tree->down[2] = -1;
+      tree->depth = 2;
+      INFO(NCCL_GRAPH, "Switchless tree %d: %d -> %d -> %d/%d",
+           c + t * comm->nChannels, tree->up, comm->rank, tree->down[0], tree->down[1]);
+    }
+  }
+  return ncclSuccess;
+}
