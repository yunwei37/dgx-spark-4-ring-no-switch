ARG BUILD_IMAGE=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
ARG RUNTIME_IMAGE=docker.io/lmsysorg/sglang@sha256:73f9294b78e38d8cc297bfed16daec8ac192b126a2d1fb9055e259a632c68f00
ARG MESH_IMAGE=mesh-builder
FROM ${BUILD_IMAGE} AS mesh-builder

ARG NCCL_COMMIT=b91894bd5b190c874d98a017f93f5daa515b65d0
ARG MESH_COMMIT=19924dcc7c571d6e260953724d394ae50bad82cf

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates git libibverbs-dev pkg-config \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/NVIDIA/nccl.git /src/nccl \
    && git -C /src/nccl checkout "${NCCL_COMMIT}" \
    && make -C /src/nccl -j"$(nproc)" src.build CUDA_HOME=/usr/local/cuda \
    && git clone https://github.com/autoscriptlabs/nccl-mesh-plugin.git /src/mesh \
    && git -C /src/mesh checkout "${MESH_COMMIT}" \
    && make -C /src/mesh -j"$(nproc)" \
    && mkdir -p /opt/nccl-mesh/lib \
    && install -m 0755 /src/nccl/build/lib/libnccl.so.2.29.7 /opt/nccl-mesh/lib/ \
    && install -m 0755 /src/mesh/libnccl-net.so /opt/nccl-mesh/lib/ \
    && ln -s libnccl.so.2.29.7 /opt/nccl-mesh/lib/libnccl.so.2 \
    && ln -s libnccl.so.2 /opt/nccl-mesh/lib/libnccl.so \
    && ln -s libnccl-net.so /opt/nccl-mesh/lib/libnccl-net-mesh.so

FROM ${MESH_IMAGE} AS mesh-runtime
FROM ${RUNTIME_IMAGE}

ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="DGX Spark four-ring GLM-5.3 NVFP4 runtime" \
      org.opencontainers.image.description="Pinned SGLang runtime with NCCL Mesh and measured GB10 fastsafetensors fixes" \
      org.opencontainers.image.source="https://github.com/yunwei37/dgx-spark-4-ring-no-switch" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="MIT"

COPY --from=mesh-runtime /opt/nccl-mesh /opt/nccl-mesh
RUN python3 -m pip install --no-cache-dir --no-deps fastsafetensors==0.3.3
COPY images/runtime/apply_fastsafetensors_033_batch_release.py /tmp/
COPY images/runtime/apply_sglang_fastsafetensors_local_device.py /tmp/
RUN python3 /tmp/apply_fastsafetensors_033_batch_release.py \
    && python3 /tmp/apply_sglang_fastsafetensors_local_device.py \
    && python3 -m py_compile \
      "$(python3 -c 'import fastsafetensors.parallel_loader as loader; print(loader.__file__)')" \
      /sgl-workspace/sglang/python/sglang/srt/model_loader/weight_utils.py \
    && test "$(python3 -c 'import importlib.metadata; print(importlib.metadata.version("fastsafetensors"))')" = "0.3.3" \
    && rm /tmp/apply_fastsafetensors_033_batch_release.py \
          /tmp/apply_sglang_fastsafetensors_local_device.py

ENV LD_LIBRARY_PATH=/opt/nccl-mesh/lib:/usr/local/cuda/lib64:/usr/local/lib/python3.12/dist-packages/nvidia/nccl/lib
