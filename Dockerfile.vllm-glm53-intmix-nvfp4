ARG RUNTIME_IMAGE=ghcr.io/drowzeys/vllm-node-tf5-glm52-b12x@sha256:e006935eb4f8266705f213c369de1eac8de7d20417254c5f234601a2fd56d481
FROM ${RUNTIME_IMAGE}

ARG VCS_REF=unknown
ARG NVFP4_PORT_COMMIT=34e81562984bda993e0c9ed01ed6900c17e4857b
LABEL org.opencontainers.image.title="DGX Spark GLM-5.3 Int4/Int8Mix NVFP4-KV runtime" \
      org.opencontainers.image.description="Pinned b12x runtime with the upstream NVFP4 MLA KV port baked into the image" \
      org.opencontainers.image.source="https://github.com/yunwei37/dgx-spark-4-ring-no-switch" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="NOASSERTION" \
      io.yunwei37.nvfp4-port-revision="${NVFP4_PORT_COMMIT}"

ADD --checksum=sha256:7c8d22715693cfa7ddb428d761b6fac71935adcdf3a77c58c80768061d876a72 \
    https://github.com/tonyd2wild/GLM-5.2-NVFP4-KV-4x-DGX-Spark-300kctx-42tok-s/archive/34e81562984bda993e0c9ed01ed6900c17e4857b.tar.gz \
    /tmp/nvfp4-port.tar.gz

RUN set -eux; \
    mkdir -p /tmp/nvfp4-port; \
    tar -xzf /tmp/nvfp4-port.tar.gz -C /tmp/nvfp4-port --strip-components=1; \
    test "$(python3 -c 'import vllm; print(vllm.__version__)')" = \
      "0.23.1rc1.dev190+gab6660699.d20260705"; \
    port=/tmp/nvfp4-port/port; \
    sp=/usr/local/lib/python3.12/dist-packages; \
    mla=${sp}/vllm/v1/attention/backends/mla; \
    ops=${sp}/vllm/v1/attention/ops/deepseek_v4_ops; \
    test -f ${port}/apply_nvfp4_plumbing.py; \
    test -f ${port}/nvfp4_glm_kernels.py; \
    install -m 0644 ${port}/nvfp4_glm_kernels.py ${mla}/nvfp4_glm_kernels.py; \
    for file in ${port}/b12x-nvfp4/*.py; do \
      base="$(basename "${file}")"; \
      case "${base}" in \
        b12x_sparse_helpers.py) install -m 0644 "${file}" "${ops}/${base}" ;; \
        fp4.py) install -m 0644 "${file}" "${sp}/b12x/cute/${base}" ;; \
        *) install -m 0644 "${file}" "${sp}/b12x/attention/mla/${base}" ;; \
      esac; \
    done; \
    python3 ${port}/apply_nvfp4_plumbing.py --image ${sp}/vllm; \
    mkdir -p /tmp/nvfp4-overlay; \
    cp ${mla}/flashmla_sparse.py /tmp/nvfp4-overlay/flashmla_sparse.py; \
    python3 ${port}/apply_nvfp4_plumbing.py --overlay /tmp/nvfp4-overlay; \
    install -m 0644 /tmp/nvfp4-overlay/flashmla_sparse.py ${mla}/flashmla_sparse.py; \
    find ${sp}/vllm ${sp}/b12x -type d -name __pycache__ -prune -exec rm -rf {} +; \
    python3 -m py_compile \
      ${mla}/flashmla_sparse.py \
      ${mla}/nvfp4_glm_kernels.py \
      ${ops}/b12x_sparse_helpers.py \
      ${sp}/b12x/attention/mla/*.py; \
    python3 -c 'import typing; from vllm.config.cache import CacheDType; assert "nvfp4_ds_mla" in typing.get_args(CacheDType)'; \
    python3 -c 'from vllm.v1.attention.backends.mla.flashmla_sparse import FlashMLASparseBackend as B; assert "nvfp4_ds_mla" in B.supported_kv_cache_dtypes'; \
    rm -rf /tmp/nvfp4-port /tmp/nvfp4-port.tar.gz /tmp/nvfp4-overlay
